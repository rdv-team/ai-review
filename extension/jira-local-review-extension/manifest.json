{
  "manifest_version": 3,
  "name": "RDV AIR — AI Review",
  "version": "1.2.0",
  "minimum_chrome_version": "102",
  "description": "RDV AIR — AI Review: запуск локального ревью из Jira.",
  "icons": {
    "16": "icons/review-default-16.png",
    "32": "icons/review-default-32.png",
    "48": "icons/review-default-48.png",
    "128": "icons/review-default-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/review-default-16.png",
      "32": "icons/review-default-32.png",
      "48": "icons/review-default-48.png",
      "128": "icons/review-default-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "RDV AIR"
  },
  "permissions": ["activeTab", "alarms", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/browse/*"],
      "js": ["issue.js", "extractor.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
